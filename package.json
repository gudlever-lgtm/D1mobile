{
  "name": "askegrav",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "python3 -m http.server 8080 --bind 0.0.0.0 --directory www",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "test": "node tests/browser.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
